# Учётные данные СДЭК (личный кабинет → «Интеграция» → «Создать ключ»).
# Для учебной среды подходят публичные тестовые ключи из apidoc.cdek.ru.
CDEKX_CLIENT_ID=
CDEKX_CLIENT_SECRET=

# production | sandbox
CDEKX_ENVIRONMENT=sandbox

# Переопределение базового URL (прокси, локальный стенд). Пусто = по среде.
CDEKX_BASE_URL=

# Таймаут запроса, сек
CDEKX_TIMEOUT=30

# Секретная часть пути для приёма вебхуков: https://example.com/webhooks/cdek/<SECRET>
CDEKX_WEBHOOK_SECRET=

# Включить интеграционные тесты против api.edu.cdek.ru (1/0)
CDEKX_RUN_INTEGRATION=0

# Уровень логирования библиотеки
CDEKX_LOG_LEVEL=INFO
